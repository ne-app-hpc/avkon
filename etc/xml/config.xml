<project modelVersion="1.0.0">

  <groupId>org.nekernel.ne_app</groupId>
  <artifactId>ADB</artifactId>
  <version>1.1.1-ADB-PUBLIC</version>
  <versionBcd>0x1000000</versionBcd>
  <packaging>shared-library</packaging>

  <name>ADB</name>
  <description>The ADB SDK in modern C++</description>
  <url>https://docs.adb.nekernel.org</url>

  <organization>
    <name>Ne.app</name>
    <url>https://www.ne-app.eu</url>
  </organization>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <file>LICENSE.txt</file>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/ne-app/adb</url>
    <connection>scm:git:https://github.com/ne-app/adb.git</connection>
  </scm>

  <properties>
    <cxx.standard>23</cxx.standard>
    <cmake.minimumVersion>3.25.1</cmake.minimumVersion>
    <build.positionIndependentCode>true</build.positionIndependentCode>
    <namespace.root>ne_app</namespace.root>
    <install.enabled>false</install.enabled>
    <install.includeDestination>include</install.includeDestination>
  </properties>

  <dependencies>
    <dependency>
      <artifactId>Boost</artifactId>
      <scope>compile</scope>
      <required>true</required>
      <finder>find_package</finder>
    </dependency>
    <dependency>
      <artifactId>TBB</artifactId>
      <scope>compile</scope>
      <required>true</required>
      <finder>find_package</finder>
    </dependency>
    <dependency>
      <artifactId>GTK</artifactId>
      <scope>compile</scope>
      <required>true</required>
      <finder>find_package</finder>
    </dependency>
    <dependency>
      <artifactId>javascriptcoregtk-4.1</artifactId>
      <scope>compile</scope>
      <required>true</required>
      <finder>pkg_config</finder>
      <platforms>
        <platform>linux</platform>
        <platform>darwin</platform>
      </platforms>
    </dependency>
    <dependency>
      <artifactId>gtk4</artifactId>
      <scope>compile</scope>
      <required>true</required>
      <finder>pkg_config</finder>
      <platforms>
        <platform>linux</platform>
        <platform>darwin</platform>
      </platforms>
    </dependency>
    <dependency>
      <artifactId>webkit2gtk-4.1</artifactId>
      <scope>compile</scope>
      <required>true</required>
      <finder>pkg_config</finder>
      <platforms>
        <platform>linux</platform>
        <platform>darwin</platform>
      </platforms>
    </dependency>
  </dependencies>

  <build>
    <includeDirectory>include</includeDirectory>
    <sourceDirectory>src</sourceDirectory>
    <sources>
      <source>src/ne_app/app/pdf.viewer.cpp</source>
      <source>src/ne_app/app/html.viewer.cpp</source>
      <source>src/ne_app/pdf.cpp</source>
      <source>src/ne_app/store.cpp</source>
    </sources>
    <testDirectory>test</testDirectory>
    <benchmarkDirectory>benchmark</benchmarkDirectory>
    <exampleDirectory>example</exampleDirectory>
    <resourceDirectory>etc/res</resourceDirectory>
  </build>

  <!-- Framework runtime: what the ADB framework loads and shows. -->
  <framework>
    <viewers>
      <viewer id="pdf">
        <title>ADB - PDF Viewer</title>
        <entryPoint>ne_app::pdf::render</entryPoint>
        <window>
          <width>1280</width>
          <height>720</height>
          <sizeHint>WEBVIEW_HINT_NONE</sizeHint>
        </window>
        <debug>false</debug>
      </viewer>
      <viewer id="html">
        <title>ADB - HTML Viewer</title>
        <entryPoint>ne_app::html::render</entryPoint>
        <window>
          <width>1280</width>
          <height>720</height>
          <sizeHint>WEBVIEW_HINT_NONE</sizeHint>
        </window>
        <debug>false</debug>
      </viewer>
    </viewers>

    <store>
      <databaseFile></databaseFile>
      <indexFiles>NO</indexFiles>
    </store>

    <tasks>
      <maxConcurrency>0</maxConcurrency><!-- 0 = defer to TBB -->
    </tasks>
  </framework>

</project>
